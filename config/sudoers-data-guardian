# ==============================================================================
# Linux Data Guardian — Sudoers Configuration
# Installed to: /etc/sudoers.d/linux-data-guardian
#
# Grants the invoking user permission to run ONLY the dedicated
# data-guardian-helper script. The helper validates every argument itself, so no
# wildcard is required here.
# ==============================================================================

@USER@ ALL=(root) NOPASSWD: /usr/local/libexec/data-guardian-helper
