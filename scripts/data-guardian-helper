#!/usr/bin/env bash
# ==============================================================================
# Linux Data Guardian — Privileged Firewall Helper
# Location: /usr/local/libexec/data-guardian-helper
# Owner:    root:root (Permissions: 0755)
#
# Security: Accepts ONLY strictly validated actions affecting ONLY
#           the dedicated 'table inet data_guardian' in nftables.
#           Rejects all arbitrary commands and unvalidated interface strings.
# ==============================================================================

set -euo pipefail

TABLE_NAME="data_guardian"

# Validate root privileges
if [ "$(id -u)" -ne 0 ]; then
    echo "[!] Error: data-guardian-helper must be executed as root." >&2
    exit 1
fi

# Ensure nft binary exists
NFT="/usr/sbin/nft"
if [ ! -x "$NFT" ]; then
    NFT=$(command -v nft 2>/dev/null || true)
    if [ -z "$NFT" ] || [ ! -x "$NFT" ]; then
        echo "[!] Error: nft binary not found." >&2
        exit 1
    fi
fi

# Action parameter
ACTION="${1:-}"

# Regex for valid Linux network interface name:
# e.g., wlp0s20f3, wlan0, eth0, enp3s0
IFACE_REGEX="^[a-zA-Z0-9_\.\-]+$"

validate_interface() {
    local iface="${1:-}"
    if [ -z "$iface" ]; then
        echo "[!] Error: Missing interface argument." >&2
        exit 2
    fi
    if ! [[ "$iface" =~ $IFACE_REGEX ]]; then
        echo "[!] Error: Invalid network interface format: '$iface'" >&2
        exit 2
    fi
}

case "$ACTION" in
    --status)
        if "$NFT" list table inet "$TABLE_NAME" >/dev/null 2>&1; then
            echo "active"
            exit 0
        else
            echo "inactive"
            exit 1
        fi
        ;;

    --flush)
        if "$NFT" list table inet "$TABLE_NAME" >/dev/null 2>&1; then
            "$NFT" delete table inet "$TABLE_NAME"
            echo "[+] Successfully flushed table inet $TABLE_NAME."
        else
            echo "[i] Table inet $TABLE_NAME was not active."
        fi
        exit 0
        ;;

    --apply-balanced)
        IFACE="${2:-}"
        validate_interface "$IFACE"

        RULESET=$(cat <<EOF
table inet $TABLE_NAME {
    chain output {
        type filter hook output priority 0; policy accept;

        # 1. Always accept loopback traffic
        oif "lo" accept

        # 2. Accept established and related connections
        ct state established,related accept

        # 3. Drop invalid connection states
        ct state invalid drop

        # 4. Essential network services: DNS, DHCP, NTP
        udp dport {53, 67, 68, 123} accept
        tcp dport {53} accept

        # 5. Balanced Mode: Drop unapproved background APT updates on metered interface
        # UID 42 (_apt) sandbox downloads are blocked
        oif "$IFACE" skuid 42 ct state new drop
    }
}
EOF
)
        # Pre-validate ruleset syntax without committing
        echo "$RULESET" | "$NFT" -c -f -
        # Commit atomically
        echo "$RULESET" | "$NFT" -f -
        echo "[+] Successfully applied BALANCED ruleset on interface $IFACE."
        exit 0
        ;;

    --apply-strict)
        IFACE="${2:-}"
        validate_interface "$IFACE"

        # Staged Strict Mode: Falls back safely to balanced policy plus UID 42 drop
        # until full cgroupv2 process hierarchy supervisor is active
        RULESET=$(cat <<EOF
table inet $TABLE_NAME {
    chain output {
        type filter hook output priority 0; policy accept;

        oif "lo" accept
        ct state established,related accept
        ct state invalid drop

        udp dport {53, 67, 68, 123} accept
        tcp dport {53} accept

        # Strict Profile (Staged): Block background updaters
        oif "$IFACE" skuid 42 ct state new drop
    }
}
EOF
)
        echo "$RULESET" | "$NFT" -c -f -
        echo "$RULESET" | "$NFT" -f -
        echo "[+] Successfully applied STRICT ruleset on interface $IFACE."
        exit 0
        ;;

    --apply-blocked)
        IFACE="${2:-}"
        validate_interface "$IFACE"

        # Quota Exhaustion Mode: Hard cut-off on metered interface
        # Established connections on $IFACE are NOT accepted to prevent streaming leaks.
        RULESET=$(cat <<EOF
table inet $TABLE_NAME {
    chain output {
        type filter hook output priority 0; policy accept;

        # 1. Loopback always allowed
        oif "lo" accept

        # 2. Allow only core local network services (DNS, DHCP)
        udp dport {53, 67, 68} accept
        tcp dport {53} accept

        # 3. Hard cut-off on the metered interface (drops both new and established)
        oif "$IFACE" drop
    }
}
EOF
)
        echo "$RULESET" | "$NFT" -c -f -
        echo "$RULESET" | "$NFT" -f -
        echo "[+] Successfully applied QUOTA BLOCKED ruleset on interface $IFACE."
        exit 0
        ;;

    --allow-apt-window)
        IFACE="${2:-}"
        validate_interface "$IFACE"

        # Temporarily removes the UID 42 drop rule while preserving general protection
        RULESET=$(cat <<EOF
table inet $TABLE_NAME {
    chain output {
        type filter hook output priority 0; policy accept;

        oif "lo" accept
        ct state established,related accept
        ct state invalid drop

        udp dport {53, 67, 68, 123} accept
        tcp dport {53} accept

        # APT window active: UID 42 allowed
        skuid 42 accept
    }
}
EOF
)
        echo "$RULESET" | "$NFT" -c -f -
        echo "$RULESET" | "$NFT" -f -
        echo "[+] Successfully opened APT download window on interface $IFACE."
        exit 0
        ;;

    *)
        echo "[!] Error: Unrecognized action '$ACTION'." >&2
        echo "Usage: data-guardian-helper {--status|--flush|--apply-balanced <iface>|--apply-strict <iface>|--apply-blocked <iface>|--allow-apt-window <iface>}" >&2
        exit 2
        ;;
esac
