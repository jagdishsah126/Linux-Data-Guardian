#!/usr/bin/env bash
# ==============================================================================
# Linux Data Guardian — Privileged Firewall Helper
# Location: /usr/local/libexec/data-guardian-helper
# Owner:    root:root (Permissions: 0755)
#
# Security model
# --------------
# This is the ONLY privileged surface of Linux Data Guardian. It:
#   * refuses to run as non-root;
#   * accepts a fixed, enumerated set of actions;
#   * touches ONLY `table inet data_guardian`;
#   * validates every ruleset with `nft -c` before committing it;
#   * rejects rulesets that reference any other table, `flush ruleset`, or `include`;
#   * never evaluates, sources or imports anything supplied by a caller.
# ==============================================================================

set -euo pipefail

TABLE_NAME="data_guardian"
CGROUP_ROOT="/sys/fs/cgroup"
CGROUP_BASE="${CGROUP_ROOT}/data_guardian"
MAX_RULESET_BYTES=65536
MAX_CGROUP_PIDS=512

if [ "$(id -u)" -ne 0 ]; then
    echo "[!] Error: data-guardian-helper must be executed as root." >&2
    exit 1
fi

NFT="/usr/sbin/nft"
if [ ! -x "$NFT" ]; then
    NFT=$(command -v nft 2>/dev/null || true)
    if [ -z "$NFT" ] || [ ! -x "$NFT" ]; then
        echo "[!] Error: nft binary not found." >&2
        exit 1
    fi
fi

ACTION="${1:-}"

# ------------------------------------------------------------------ validation
validate_cgroup_name() {
    case "${1:-}" in
        foreground|whitelist) ;;
        *) echo "[!] Error: unknown cgroup '${1:-}'." >&2; exit 2 ;;
    esac
}

validate_pid() {
    local pid="${1:-}"
    if ! [[ "$pid" =~ ^[0-9]+$ ]] || [ "$pid" -lt 2 ] || [ "$pid" -gt 4194304 ]; then
        echo "[!] Error: invalid pid '$pid'." >&2
        exit 2
    fi
}

validate_ruleset() {
    # Read stdin (bounded) and apply defence-in-depth checks before nft sees it.
    local ruleset
    ruleset=$(head -c "$MAX_RULESET_BYTES")
    if [ -z "$ruleset" ]; then
        echo "[!] Error: empty ruleset." >&2
        exit 2
    fi

    # 1. Forbid global/IO directives outright.
    if printf '%s\n' "$ruleset" \
        | grep -Eq '(^|[^[:alnum:]_])(flush[[:space:]]+ruleset|include|exec|define|redefine)[[:space:]]'; then
        echo "[!] Error: ruleset contains a forbidden directive." >&2
        exit 2
    fi

    # 2. Every table statement must target exactly 'table inet data_guardian'.
    local table_lines bad
    table_lines=$(printf '%s\n' "$ruleset" \
        | grep -E '^[[:space:]]*(table|add[[:space:]]+table|delete[[:space:]]+table|destroy[[:space:]]+table|flush[[:space:]]+table)' || true)
    if [ -n "$table_lines" ]; then
        bad=$(printf '%s\n' "$table_lines" \
            | grep -Ev "^[[:space:]]*(table|add[[:space:]]+table|delete[[:space:]]+table|destroy[[:space:]]+table|flush[[:space:]]+table)[[:space:]]+(inet|ip|ip6|bridge|netdev|arp)[[:space:]]+${TABLE_NAME}[[:space:]]*\{?[[:space:]]*$" || true)
        if [ -n "$bad" ]; then
            echo "[!] Error: ruleset references a table other than ${TABLE_NAME}:" >&2
            printf '%s\n' "$bad" >&2
            exit 2
        fi
    fi

    # 3. The ruleset must actually target our table.
    if ! printf '%s\n' "$ruleset" \
        | grep -Eq '(^|[[:space:]])(table|destroy[[:space:]]+table)[[:space:]]+inet[[:space:]]+'"${TABLE_NAME}"'([[:space:]]|\{|$)'; then
        echo "[!] Error: ruleset does not target table inet ${TABLE_NAME}." >&2
        exit 2
    fi

    printf '%s\n' "$ruleset"
}

apply_ruleset() {
    local ruleset="$1"
    if ! printf '%s' "$ruleset" | "$NFT" -c -f - >/dev/null 2>&1; then
        echo "[!] Error: ruleset failed nft syntax validation." >&2
        printf '%s' "$ruleset" | "$NFT" -c -f - >&2 || true
        exit 3
    fi
    printf '%s' "$ruleset" | "$NFT" -f - >/dev/null
    echo "[+] Ruleset applied (table inet ${TABLE_NAME})."
}

# ---------------------------------------------------------------------- actions
case "$ACTION" in
    --status)
        if "$NFT" list table inet "$TABLE_NAME" >/dev/null 2>&1; then
            echo "active"
            exit 0
        fi
        echo "inactive"
        exit 1
        ;;

    --flush)
        if "$NFT" list table inet "$TABLE_NAME" >/dev/null 2>&1; then
            "$NFT" delete table inet "$TABLE_NAME"
            echo "[+] Successfully flushed table inet ${TABLE_NAME}."
        else
            echo "[i] Table inet ${TABLE_NAME} was not active."
        fi
        # Verify it is really gone.
        if "$NFT" list table inet "$TABLE_NAME" >/dev/null 2>&1; then
            echo "[!] Error: table inet ${TABLE_NAME} still present after flush." >&2
            exit 3
        fi
        exit 0
        ;;

    --apply-stdin)
        RULESET=$(validate_ruleset)
        # Strict rulesets reference cgroups; make sure they exist before nft
        # validates the path, otherwise a valid ruleset would be rejected.
        if printf '%s' "$RULESET" | grep -q 'cgroupv2'; then
            if [ -d "$CGROUP_ROOT" ]; then
                mkdir -p "$CGROUP_BASE/foreground" "$CGROUP_BASE/whitelist" 2>/dev/null || true
            fi
        fi
        apply_ruleset "$RULESET"
        exit 0
        ;;

    --cgroup-init)
        # Create the two cgroups used by strict-mode socket matching.
        if [ ! -d "$CGROUP_ROOT" ]; then
            echo "[!] Error: cgroup v2 is not mounted at ${CGROUP_ROOT}." >&2
            exit 4
        fi
        mkdir -p "$CGROUP_BASE/foreground" "$CGROUP_BASE/whitelist"
        chmod 0755 "$CGROUP_BASE" "$CGROUP_BASE/foreground" "$CGROUP_BASE/whitelist"
        echo "[+] cgroups ready: ${CGROUP_BASE}/{foreground,whitelist}"
        exit 0
        ;;

    --cgroup-set)
        GROUP="${2:-}"
        validate_cgroup_name "$GROUP"
        shift 2
        if [ "$#" -eq 0 ]; then
            echo "[!] Error: --cgroup-set requires at least one pid." >&2
            exit 2
        fi
        if [ "$#" -gt "$MAX_CGROUP_PIDS" ]; then
            echo "[!] Error: too many pids ($# > ${MAX_CGROUP_PIDS})." >&2
            exit 2
        fi
        if [ ! -d "$CGROUP_BASE/$GROUP" ]; then
            echo "[!] Error: cgroups not initialised (run --cgroup-init)." >&2
            exit 4
        fi
        # Replace membership: drain the old set back to the root cgroup first.
        # Without this, a previously focused app would stay allowed forever.
        if [ -f "$CGROUP_BASE/$GROUP/cgroup.procs" ]; then
            while read -r old_pid; do
                [ -n "$old_pid" ] || continue
                printf '%s' "$old_pid" > "$CGROUP_ROOT/cgroup.procs" 2>/dev/null || true
            done < "$CGROUP_BASE/$GROUP/cgroup.procs"
        fi
        moved=0
        for pid in "$@"; do
            validate_pid "$pid"
            if [ -d "/proc/$pid" ]; then
                printf '%s' "$pid" > "$CGROUP_BASE/$GROUP/cgroup.procs" 2>/dev/null && moved=$((moved + 1)) || true
            fi
        done
        echo "[+] Moved ${moved} process(es) into ${GROUP}."
        exit 0
        ;;

    --cgroup-clear)
        GROUP="${2:-}"
        validate_cgroup_name "$GROUP"
        if [ -d "$CGROUP_BASE/$GROUP" ] && [ -f "$CGROUP_BASE/$GROUP/cgroup.procs" ]; then
            # Move everything back to the root cgroup.
            while read -r pid; do
                [ -n "$pid" ] || continue
                printf '%s' "$pid" > "$CGROUP_ROOT/cgroup.procs" 2>/dev/null || true
            done < "$CGROUP_BASE/$GROUP/cgroup.procs"
        fi
        echo "[+] Cleared cgroup ${GROUP}."
        exit 0
        ;;

    *)
        echo "[!] Error: Unrecognized action '${ACTION}'." >&2
        echo "Usage: data-guardian-helper {--status|--flush|--apply-stdin|--cgroup-init|--cgroup-set <foreground|whitelist> <pid>...|--cgroup-clear <foreground|whitelist>}" >&2
        exit 2
        ;;
esac
